{
  "manifest_version": 3,
  "name": "JDownloader Download Interceptor",
  "version": "0.6.0",
  "description": "Toggle Chromium download interception and choose between a configurable JDownloader instance and the browser's native downloader.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "http://192.168.1.102/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "JDownloader Download Interceptor"
  }
}
